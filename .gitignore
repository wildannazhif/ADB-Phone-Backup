# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller temporary build spec (can be regenerated with build_exe.py)
*.spec

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Node / Frontend build artifacts
node_modules/
dist-ui/
.vite/

# Rust / Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Staged standalone packaging payloads (generated by scripts/prepare_bundle.py)
src-tauri/resources/python-runtime/
src-tauri/resources/platform-tools/
src-tauri/resources/backend/
*.msi
*.nsis

# Test cache
.pytest_cache/
